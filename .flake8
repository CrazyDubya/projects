[flake8]
max-line-length = 88
# E203 whitespace before ':', E501 line too long (black), W503 line break before
# binary operator, E402 module level import not at top (common in scripts)
extend-ignore = E203,E501,W503,E402
exclude = .git,__pycache__,.venv,venv,.pytest_cache,*.egg-info,build,dist
per-file-ignores =
    */4x/*.py:E501
    */hive-mind/*.py:E501
    */ant/*.py:T201
    */allseeingeye/*.py:T201
    */mover/*.py:T201
max-complexity = 15
